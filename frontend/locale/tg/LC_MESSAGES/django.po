#: backend/places/views.py:23 frontend/templates/home.html:26
msgid "Определить моё местоположение"
msgstr "Ҷойи манро муайян кун"

#: backend/places/views.py:24 frontend/templates/home.html:31
msgid "Точка выбрана — нажмите ещё раз, чтобы убрать"
msgstr "Нуқта интихоб шуд — барои тоза кардан боз зер кунед"

#: backend/places/views.py:25
msgid "Загрузка…"
msgstr "Боргирӣ…"

#: backend/places/views.py:26
msgid "Рядом пока нет мест"
msgstr "Дар наздикӣ ҷойҳо нестанд"

#: backend/places/views.py:27
msgid "Не удалось получить данные"
msgstr "Гирифтани маълумот нарасид"

#: backend/places/views.py:28
msgid "Закрыть"
msgstr "Пӯшидан"

#: backend/places/views.py:29
msgid "Сложность доступа"
msgstr "Мушкилии дастрасӣ"

#: backend/places/views.py:30
msgid "Часы работы"
msgstr "Соатҳои кор"

#: backend/places/views.py:31
msgid "Входная цена"
msgstr "Нархи даромад"

#: backend/places/views.py:32
msgid "Рекомендуемое время"
msgstr "Вақти тавсияшуда"

#: backend/places/views.py:33
msgid "Регион"
msgstr "Минтақа"

#: backend/places/views.py:34
msgid "сомони"
msgstr "сомонӣ"

#: backend/places/views.py:35
msgid "Кликните по точке маршрута, чтобы открыть место"
msgstr "Ба нуқтаи масъир зеро занед, то ҷой кушода шавад"

#: backend/places/views.py:36
msgid "Итого"
msgstr "Ҳамагӣ"

#: backend/places/views.py:37
#, fuzzy
#| msgid "Рядом пока нет мест"
msgid "Рядом не найдено мест"
msgstr "Дар наздикӣ ҷойҳо нестанд"

#: backend/places/views.py:38
msgid "км"
msgstr "км"

#: frontend/templates/home.html:3
msgid "Карта мест"
msgstr "Харитаи ҷойҳо"

#: frontend/templates/home.html:15
msgid "Карта ещё не подключена: не задан ключ MapTiler в настройках."
msgstr ""
"Харита пайваст нашудааст: калиди MapTiler дар танзимот гузошта нашудааст."

#: frontend/templates/home.html:19
msgid "Все"
msgstr "Ҳама"

#: frontend/templates/home.html:27
msgid "Маршрут"
msgstr "Масъир"

#: frontend/templates/home.html:28
msgid "3D-рельеф"
msgstr "Релефи 3D"

#: frontend/templates/home.html:35
msgid "Ближайшие места"
msgstr "Ҷойҳои наздиктарин"

#~ msgid "Туристическое приложение по Таджикистану"
#~ msgstr "Барномаи туристии Тоҷикистон"
