# Скопируй этот файл в .env и заполни реальными значениями.
# Никогда не коммить реальные ключи и пароли.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- База данных (PostgreSQL + PostGIS) ----
# Удобный вариант: одна строка подключения (Neon/Render/docker-compose).
# Приоритет у DATABASE_URL — он перекрывает отдельные переменные DB_*.
DATABASE_URL=postgresql://kuhiston:kuhiston@127.0.0.1:5432/kuhiston

# PostGIS-движок Django (активировать только при установленных GEOS+GDAL):
# USE_POSTGIS_BACKEND=1

# Либо отдельными переменными:
DB_ENGINE=django.contrib.gis.db.backends.postgis
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=

# Карта (MapTiler) — ключ выдаётся отдельно, не хранить в коде
MAPTILER_API_KEY=ZxtfUL3Th4py6XWdwgTR

# Донаты (Этап 7) — внешняя ссылка на платёжную страницу (заполняет основатель)
# DONATE_URL=https://example.com/donate